# Copy this file to .env.local and fill in real values. Never commit
# .env.local - it is already excluded by .gitignore (.env* is ignored,
# this file is explicitly un-ignored so it can be tracked as a template).

# ── Supabase ─────────────────────────────────────────────────────────────
# Project URL and anon key: safe to expose to the browser (NEXT_PUBLIC_*),
# access is enforced by Postgres RLS policies, not by keeping these secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key: bypasses RLS entirely. Server-side only - used by
# src/lib/db/supabase-server.ts and the InSAR importer. NEVER reference
# this from a "use client" component or expose it via any API response.
SUPABASE_SERVICE_ROLE_KEY=

# ── Authentication ──────────────────────────────────────────────────────
# Supabase Auth itself is configured via the two variables above (this
# project uses Supabase's built-in auth, not a separate auth provider).
# Role assignment (viewer/operator/admin) lives in the `profiles` table -
# see src/lib/auth/roles.ts.

# Bootstrap admin credentials, used only by `npm run seed:admin`
# (tools/seed-admin.mjs). Defaults to the documented LOCAL/DEMO credentials
# (admin@iris.local / test123 - see docs/DEMO_GUIDE.md) when unset. Set both
# to real, unique values before running the seed script against any
# non-local Supabase project - the script does not silently recreate the
# demo account if a user with this email already exists.
IRIS_ADMIN_EMAIL=
IRIS_ADMIN_PASSWORD=

# ── Gateway ingestion ────────────────────────────────────────────────────
# Shared secret the sensor gateway must send as `x-gateway-key` on every
# POST /api/ingest request. Generate a long random value per deployment.
GATEWAY_SHARED_SECRET=

# ── Demo site configuration ─────────────────────────────────────────────
# This is a single-site prototype (no multi-tenant UI). All server routes
# read the active site_id from here (src/lib/config/site.ts). Leave unset
# to use the seeded demo site id "SIH-DEMO-01".
DEMO_SITE_ID=

# ── Email (Resend) ───────────────────────────────────────────────────────
# Optional - if unset, email notifications run in DEMO_MODE (simulated
# sends, logged not delivered). See src/lib/adapters/email-adapter.ts.
RESEND_API_KEY=
ALERT_EMAIL_FROM=

# ── SMS + Voice (Twilio) ─────────────────────────────────────────────────
# Optional - if unset, SMS/voice notifications run in DEMO_MODE. See
# src/lib/adapters/sms-adapter.ts and voice-adapter.ts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Required for voice only - a public HTTPS URL Twilio can reach for the
# TwiML/DTMF webhooks (a tunnel such as ngrok in local dev, or your real
# deployed URL). Twilio cannot reach localhost.
PUBLIC_BASE_URL=

# ── ML prediction service ────────────────────────────────────────────────
# Optional - if unset, /api/predictions/latest falls back to mock/no
# prediction rather than fabricating one. See src/lib/adapters/ml-adapter.ts.
ML_SERVICE_URL=
ML_SERVICE_TOKEN=

# Force demo/simulated-send mode for notifications even if provider
# credentials above are set. "true" or unset/"false".
DEMO_MODE=
