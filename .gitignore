# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.tmp
tmp/
temp/

# env files - .env.example is a template, not a secret, and is tracked
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python (tools/insar-importer) - it also has its own local .gitignore;
# repeated here defensively in case another Python tool is added later.
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# IDE
.vscode/*
!.vscode/extensions.json
.idea/
